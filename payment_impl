import 'dart:convert';
import 'package:dio/dio.dart';
import 'package:hdfc_merchant_app/features/dashboard_amps/data/payment_repository.dart';
import 'package:hdfc_merchant_app/features/dashboard_amps/data/payment_response_model.dart';

class PaymentAnalyticsRepositoryImpl implements PaymentAnalyticsRepository {
  final Dio _dio;

  PaymentAnalyticsRepositoryImpl({Dio? dio})
    //  : _dio = dio ?? DioProvider.create();
    : _dio =
          dio ??
          Dio(
            BaseOptions(
              baseUrl: 'https://ms.platform.hdfcuat.bank.in/dev-pf-merchants',
              connectTimeout: const Duration(seconds: 30),
              receiveTimeout: const Duration(seconds: 60),
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
            ),
          );

  @override
  Future<PaymentAnalyticsResponseModel> getPaymentAnalytics({
    String? filter,
  }) async {
    print("inside Implementation");
    try {
      final response = await _dio.post(
        '/api/v1/dashboard',
        queryParameters: {if (filter != null) 'filter': filter},
      );
      return PaymentAnalyticsResponseModel.fromJson(response.data);
    } on DioException catch (e) {
      throw Exception(e.error ?? 'Failed to load search configs');
    }
  }
}
